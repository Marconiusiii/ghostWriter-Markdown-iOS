{
  "version": 1,
  "body": {
    "font": "Georgia",
    "size": 12,
    "firstLineIndent": 24,
    "widowControl": true,
    "keepLinesTogether": false
  },
  "headings": {
    "1": { "firstLineIndent": 0, "keepWithNext": true, "keepLinesTogether": true },
    "2": { "firstLineIndent": 0, "keepWithNext": true, "keepLinesTogether": true }
  },
  "paragraphAfterHeading": { "headingLevels": [1, 2], "firstLineIndent": 0 },
  "metadata": { "author": "Your name" },
  "header": { "template": "{{author}}: {{heading1}}", "alignment": "left" },
  "footer": { "template": "{{title}} | {{pageNumber}}", "alignment": "center" },
  "differentFirstPage": true
}
