  "strings": {
    "%@ and everything inside it will move to Recently Deleted.": {
      "comment": "LibraryView.swift:352",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y todo su contenido se moverán a Eliminados recientemente."
          }
        }
      }
    },
    "%@ is not yet available on this device.": {
      "comment": "DocumentStore.swift:715",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ todavía no está disponible en este dispositivo."
