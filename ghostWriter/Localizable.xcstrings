          }
        }
      }
    },
    "ghostWriter will move your complete library to iCloud Drive. Documents, renames, edits, and deletions will then sync to your other devices using the same iCloud account. iCloud syncing is not an independent backup." : {
      "comment" : "ICloudMigrationView.swift:79",
